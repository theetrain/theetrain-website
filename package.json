{
  "name": "theetrain.ca",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prod:preview": "pnpx http-server@14.1.1 build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest"
  },
  "devDependencies": {
    "@content-collections/core": "^0.15.2",
    "@content-collections/vite": "^0.3.0",
    "@prgm/sveltekit-progress-bar": "3.0.2",
    "@sveltejs/adapter-static": "next",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.5",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fontless": "^0.3.0",
    "globals": "^17.11.0",
    "mdsvex": "^0.12.8",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "schema-dts": "^2.0.0",
    "shiki": "^4.4.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#blog/*": "./src/blog/*",
    "#content-collections": "./.content-collections/generated/index.js"
  }
