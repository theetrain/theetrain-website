    "test": "vitest"
  },
  "devDependencies": {
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@prgm/sveltekit-progress-bar": "3.0.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fontless": "^1.3.3",
    "globals": "^17.13.0",
    "mdsvex": "^0.12.8",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "schema-dts": "^2.1.0",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#blog/*": "./src/blog/*",
    "#content-collections": "./.content-collections/generated/index.js"
  }
